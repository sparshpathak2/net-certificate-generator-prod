// Update CertificateRequest to link directly to template
model CertificateRequest {
  id              String        @id @default(cuid())
  requestId       String        @unique @default(cuid())
  studentName     String
  studentEmail    String
  studentPhone    String?
  studentId       String?
  courseName      String
  completionDate  DateTime?
  department      String?
  additionalInfo  String?
  status          RequestStatus @default(PENDING)
  adminNotes      String?
  rejectionReason String?
  certificateUrl  String?
  uniqueCode      String?       @unique

  // Foreign keys
  approvedById  String?
  templateId    String? // Link to the template this request is for
  certificateId String?

  // Relationships
  approvedBy  User?        @relation("ApprovedBy", fields: [approvedById], references: [id])
  template    Template?    @relation(fields: [templateId], references: [id])
  certificate Certificate? @relation("RequestCertificate", fields: [certificateId], references: [id])

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  approvedAt DateTime?
  expiresAt  DateTime?

  // Tracking
  ipAddress String?
  userAgent String?
}

// Certificate generation history (BULK generation by admin)
model Certificate {
  id          String  @id @default(cuid())
  title       String
  description String?
  adminId     String // Admin who generated these certificates
  templateId  String

  // Foreign keys
  // adminId       String
  // templateId    String

  // Relationships
  admin    User     @relation("AdminCertificates", fields: [adminId], references: [id])
  template Template @relation(fields: [templateId], references: [id])

  totalCount  Int
  status      BulkStatus @default(PENDING)
  downloadUrl String? // Path to generated ZIP file
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  // Individual certificates from bulk generation
  certificates BulkCertificateItem[]

  // Link to requests (one certificate generation can cover multiple requests)
  requests CertificateRequest[] @relation("RequestCertificate")

  excelFile String // Path to uploaded Excel file (if bulk)
}

// Individual certificates from BULK generation
model BulkCertificateItem {
  id             String    @id @default(cuid())
  certificateId  String
  recipientName  String
  recipientEmail String?
  uniqueCode     String    @unique // For verification
  filePath       String
  isIssued       Boolean   @default(false)
  issuedAt       DateTime?
  createdAt      DateTime  @default(now())

  // Relationships
  certificate   Certificate               @relation(fields: [certificateId], references: [id])
  verifications CertificateVerification[]
}

