// Certificate templates (created by admin)
model Template {
  id          String  @id @default(cuid())
  name        String
  description String?
  filePath    String // Path to template file (PDF)
  thumbnail   String? // Thumbnail image
  width       Int? // Template width in points
  height      Int? // Template height in points
  isActive    Boolean @default(true)
  isPublic    Boolean @default(false) // Whether this template has a public claim form
  claimUrl    String? @unique // Unique URL for public claim form (e.g., "web-dev-bootcamp-2024")
  adminId     String
  requireUrn  Boolean @default(false)

  // Relationships
  admin        User                 @relation(fields: [adminId], references: [id])
  fields       TemplateField[]
  certificates Certificate[]
  requests     CertificateRequest[] // Requests specifically for this template

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Template field configurations (where text should appear)
model TemplateField {
  id         String  @id @default(cuid())
  templateId String
  fieldName  String // e.g., "studentName", "courseName", "completionDate"
  fieldLabel String // Display name
  x          Float
  y          Float
  fontSize   Int     @default(24)
  fontColor  String  @default("#000000")
  alignment  String  @default("center")
  isRequired Boolean @default(true)
  order      Int     @default(0)
  isDefault  Boolean @default(false)

  // ✅ ADD THESE FONT PROPERTIES
  fontFamily   String   @default("Helvetica")  // e.g., "Helvetica", "Lobster", "Roboto"
  fontWeight   String   @default("regular")    // "regular", "bold", "italic"
  fontStyle    String?  // Additional style if needed

  // Relationships
  template Template @relation(fields: [templateId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Email queue for sending certificates
model EmailQueue {
  id          String      @id @default(cuid())
  to          String
  toName      String
  subject     String
  content     String // HTML content
  attachments String? // JSON array of attachment paths
  status      EmailStatus @default(PENDING)
  retryCount  Int         @default(0)
  error       String?
  sentAt      DateTime?
  priority    Int         @default(5) // 1=highest, 10=lowest
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Audit log for tracking all actions
model AuditLog {
  id        String   @id @default(cuid())
  userId    String? // Admin ID (if action by admin)
  userEmail String? // Student email (if action by public)
  action    String // REQUEST_CERTIFICATE, APPROVE_REQUEST, REJECT_REQUEST, GENERATE_BULK, etc.
  entity    String // CertificateRequest, Certificate, Template
  entityId  String
  details   Json? // Additional details
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

// Verification link for certificate authenticity
model CertificateVerification {
  id            String    @id @default(cuid())
  uniqueCode    String    @unique
  certificateId String
  studentEmail  String
  studentName   String
  verifiedCount Int       @default(0)
  lastVerified  DateTime?
  createdAt     DateTime  @default(now())
  expiresAt     DateTime

  // Relationships
  certificate BulkCertificateItem @relation(fields: [certificateId], references: [id])
}

// Rate limiting for public form submissions
model RateLimit {
  id           String    @id @default(cuid())
  email        String // Student email
  ipAddress    String // IP address
  requests     Int       @default(1)
  lastRequest  DateTime  @default(now())
  blockedUntil DateTime?

  @@unique([email, ipAddress])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Enums
enum Role {
  ADMIN
  SUPERADMIN
}

enum RequestStatus {
  PENDING // Waiting for admin approval
  APPROVED // Approved, certificate generation pending
  GENERATED // Certificate generated and sent
  REJECTED // Rejected by admin
  EXPIRED // Request expired
}

enum BulkStatus {
  PENDING // Not yet started
  PROCESSING // Currently generating
  COMPLETED // Successfully generated
  FAILED // Generation failed
  PARTIAL // Some certificates failed
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
  RETRY
}
