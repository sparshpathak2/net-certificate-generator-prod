# --- Compose / image tags ---
DOCKERHUB_USER=your-dockerhub-username
BACKEND_TAG=v1
FRONTEND_TAG=v1

# --- App ---
PORT=5001
NODE_ENV=production
HOST=0.0.0.0
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=xlsx,xls,csv
SKIP_S3_UPLOAD=false

ADMIN_EMAIL=admin@certificate.com
ADMIN_URL=http://<ec2-ip-or-domain>
FRONTEND_URL=http://<ec2-ip-or-domain>

# --- Database ---
POSTGRES_DB=certificate_generator_db
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=changeme
APP_USER_PASSWORD=changeme
MIGRATE_USER_PASSWORD=changeme
DATABASE_URL=postgresql://app_user:changeme@postgres:5432/certificate_generator_db?schema=public
DIRECT_DATABASE_URL=postgresql://migrate_user:changeme@postgres:5432/certificate_generator_db?schema=public

# --- AWS S3 ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=net-certificate-generator-prod

# --- Auth ---
JWT_SECRET=changeme

# --- SMTP (fill once confirmed from certificateEmail.service.js) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=